# Copy to .env. Never commit .env. Every value is optional for `simulate`.
DEVIN_API_KEY=
DEVIN_ORG_ID=
GITHUB_TOKEN=
DEVIN_API_BASE=https://api.devin.ai
TARGET_REPO=jhomer192/superset
AUTOMATION_REPO=jhomer192/superset-devin-automation
READY_LABEL=ready
LOG_LEVEL=INFO
VERIFY_BRANCH=master
VERIFY_EVERY_N_MERGES=5
# Filled from `orchestrator register-playbooks`; unset means the fully inline prompts are used.
PLAYBOOK_ID_FIX=
PLAYBOOK_ID_VERIFY=
REPORT_DIGEST_ISSUE=
REPORT_DIGEST_EVERY_HOURS=24
# Optional USD per ACU; the API reports ACUs only, so cost is unpriced unless this is set.
ACU_USD=
